<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
    <div class="main">
        <div class="nav">
            <a href="/">Create Users</a>
        </div>

        <h1>All Users.</h1>
        <hr>
            <div class="users">
                <% users.forEach(function(user){ %>
                    <div class="user">
                        <img src="<%=user.image%>" alt="">
                        <h3><%=user.name%></h3>
                            <h3><%=user.email%></h3>
                            <div class="buttons">
                            <a href="/edit/<%=user.id%>">edit user</a>
                            <a href="/delete/<%=user.id%>">delete user</a>
                        </div>
                    </div>
                <% })%>
            </div>
    </div>
</body>

</html>