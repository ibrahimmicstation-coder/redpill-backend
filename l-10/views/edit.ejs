<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Users</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <div class="main">
        <div class="nav">
            <a href="/">Create Users</a>
            <a href="/read">Read Users</a>
        </div>

        <h1>Update User.</h1>
        <hr> 
        <form action="/edit/<%=userid%>" method="post">
            <input type="text" placeholder="enter your name" name="name" value="<%=user.name%>">
            <br>
            <input type="email" placeholder="enter your email" name="email" value="<%=user.email%>">
            <br>
            <input type="text" placeholder="enter your img url" name="image" value="<%=user.image%>">
            <br>
            <input type="submit" value="Update User">
        </form>
    </div>
</body>
</html>